msgstr "Ostatnie 4 tygodnie"

#: src/model.rs:650
msgid "Last 6 months"
msgstr "Ostatnie 6 miesięcy"

#: src/model.rs:651
msgid "Past year"
msgstr "Ostatni rok"

#: src/model.rs:660
msgid "Calculated from your listening over approximately the last 4 weeks."
